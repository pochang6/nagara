#!/bin/bash
# nagara — メニューバーで待っている本体へテキストと操作を投げる CLI。
#
# 本体は「投げ込まれたテキストだけを読む」ので、送り元は何でもよい。
# Claude Code のフックでも、Codex でも、cron でも、自作スクリプトでも。
#
#   nagara "読ませたい文章"      積むだけ（既定。鳴らない）
#   echo ... | nagara            標準入力から積む
#   nagara --now "すぐ読んで"     積んですぐ鳴らす
#   nagara play | pause | toggle | stop | back | next
#   nagara rate            速度を 1.0 → 1.2 → 1.5 と回す
#   nagara rate 1.5        速度を指定する
#   nagara volume          音量を1段上げる
#   nagara volume 0.8      音量を指定する（0.0〜1.0）
#   nagara status          いまの状態を JSON で見る
#
#   nagara yomi                    読みが怪しい語の一覧（溜まっているもの）
#   nagara yomi check "文章"        その場で調べる
#   nagara yomi dict               AivisSpeech のユーザー辞書を見る
#   nagara yomi add 再生中 サイセイチュウ [0]   辞書に入れる（候補からも消える）
#   nagara yomi skip 明日           見送る（次から出さない）
#   nagara yomi rm <uuid>          辞書から消す
set -euo pipefail

PORT="${NAGARA_PORT:-17371}"
HOST="127.0.0.1"
SOURCE="${NAGARA_SOURCE:-cli}"
# 読みの登録先。辞書は nagara ではなく AivisSpeech が持っている
ENGINE="${NAGARA_ENGINE:-http://127.0.0.1:10101}"

post() {
  local path="$1" body="${2:-{\}}"
  curl -sS -m 20 -X POST "http://$HOST:$PORT$path" \
    -H 'Content-Type: application/json' \
    -d "$body"
}

die() {
  echo "nagara: $1" >&2
  exit 1
}

# 本体が起きていなければ、まず起こす。使いたいときに迷子になるのが一番困る
ensure_app() {
  if curl -sS -m 1 "http://$HOST:$PORT/status" >/dev/null 2>&1; then
    return 0
  fi
  if [ -d /Applications/nagara.app ]; then
    open -g -a /Applications/nagara.app 2>/dev/null || true
    for _ in $(seq 1 20); do
      sleep 0.25
      curl -sS -m 1 "http://$HOST:$PORT/status" >/dev/null 2>&1 && return 0
    done
  fi
  die "本体が応答しません（/Applications/nagara.app を起動してください）"
}

json_text() {
  # 引用符や改行を安全に JSON へ入れる
  python3 -c '
import json, sys
print(json.dumps({
    "text": sys.stdin.read(),
    "source": sys.argv[1],
    **({"autoplay": True} if sys.argv[2] == "1" else {}),
}, ensure_ascii=False))
' "$SOURCE" "$1"
}

AUTOPLAY=0
if [ "${1:-}" = "--now" ]; then
  AUTOPLAY=1
  shift
fi

case "${1:-}" in
  play|pause|toggle|stop|back|next|clipboard)
    ensure_app
    post "/$1"
    echo
    ;;
  rate)
    ensure_app
    if [ -n "${2:-}" ]; then
      post "/rate" "{\"rate\": $2}"
    else
      post "/rate"
    fi
    echo
    ;;
  volume)
    ensure_app
    if [ -n "${2:-}" ]; then
      post "/volume" "{\"volume\": $2}"
    else
      post "/volume"
    fi
    echo
    ;;
  status)
    ensure_app
    post "/status"
    echo
    ;;
  yomi)
    shift
    case "${1:-}" in
      ""|pending)
        ensure_app
        post "/yomi/pending" | python3 -c '
import json, sys
data = json.load(sys.stdin)
rows = data.get("pending", [])
if not rows:
    print("怪しい読みは溜まっていません" + ("" if data.get("readingCheck") else "（見張りはオフです）"))
    raise SystemExit
for row in rows:
    print(row["surface"], "engine=" + row["engine"], "mac=" + row["guess"], row["context"][:30], sep="\t")
'
        ;;
      check)
        shift
        [ -n "${1:-}" ] || die "調べる文章がありません"
        ensure_app
        printf '%s' "$*" | python3 -c '
import json, sys
print(json.dumps({"text": sys.stdin.read()}, ensure_ascii=False))
' > /tmp/nagara-yomi-check.json
        curl -sS -m 300 -X POST "http://$HOST:$PORT/yomi/check" \
          -H 'Content-Type: application/json' -d @/tmp/nagara-yomi-check.json | python3 -c '
import json, sys
data = json.load(sys.stdin)
rows = data.get("found", [])
print(str(len(rows)) + "語")
for row in rows:
    print(row["surface"], "engine=" + row["engine"], "mac=" + row["guess"], sep="\t")
'
        rm -f /tmp/nagara-yomi-check.json
        ;;
      dict)
        curl -sS -m 10 "$ENGINE/user_dict" | python3 -c '
import json, sys
for uuid, word in json.load(sys.stdin).items():
    print(uuid, word["surface"], word["pronunciation"], "型" + str(word["accent_type"]), sep="\t")
'
        ;;
      add)
        shift
        SURFACE="${1:-}"; YOMI="${2:-}"; ACCENT="${3:-0}"
        [ -n "$SURFACE" ] && [ -n "$YOMI" ] || die "nagara yomi add <表層> <カタカナ> [アクセント型]"
        UUID="$(curl -sS -m 20 -X POST --get "$ENGINE/user_dict_word" \
          --data-urlencode "surface=$SURFACE" \
          --data-urlencode "pronunciation=$YOMI" \
          --data-urlencode "accent_type=$ACCENT" \
          --data-urlencode "word_type=COMMON_NOUN" \
          --data-urlencode "priority=8")"
        echo "$SURFACE -> $YOMI  $UUID"
        # 登録できたら候補からは落とす。見送りではないので ignore はしない
        ensure_app
        post "/yomi/resolve" "$(python3 -c '
import json, sys
print(json.dumps({"surface": sys.argv[1], "ignore": False}, ensure_ascii=False))
' "$SURFACE")" > /dev/null
        ;;
      skip)
        shift
        [ -n "${1:-}" ] || die "nagara yomi skip <表層>"
        ensure_app
        post "/yomi/resolve" "$(python3 -c '
import json, sys
print(json.dumps({"surface": sys.argv[1], "ignore": True}, ensure_ascii=False))
' "$1")" > /dev/null
        echo "$1 は次から出しません"
        ;;
      rm)
        shift
        [ -n "${1:-}" ] || die "nagara yomi rm <uuid>"
        curl -sS -m 20 -X DELETE "$ENGINE/user_dict_word/$1" -w '%{http_code}\n'
        ;;
      *)
        die "yomi のあとは pending / check / dict / add / skip / rm のどれかです"
        ;;
    esac
    ;;
  -h|--help)
    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  "")
    # 引数なしは標準入力から。 … | nagara という形
    [ -t 0 ] && die "読ませるテキストがありません（nagara --help）"
    ensure_app
    BODY="$(json_text "$AUTOPLAY")"
    post "/speak" "$BODY"
    echo
    ;;
  *)
    ensure_app
    BODY="$(printf '%s' "$*" | json_text "$AUTOPLAY")"
    post "/speak" "$BODY"
    echo
    ;;
esac
